# Example env file - the real one lives (gitignored) in the credentials repo
# a panel's config points at via `env_file:`, e.g.
# ~/GitHub/acme_credentials/acme.env. The real environment always wins over
# the file. Tokens NEVER go in the statusboard yaml itself.

# github_prs: a read-only PAT (fine-grained: Pull requests Read; classic:
# `repo` scope only if private repos are involved)
GH_PAT_PERSONAL=ghp_replace_me

# bitbucket_prs: an app password (Account read + Pull requests read)
BB_USERNAME=your_bitbucket_username
BB_APP_PASSWORD=replace_me
